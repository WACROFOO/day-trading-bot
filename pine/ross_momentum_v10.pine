//@version=6
// =============================================================================
// Ross Momentum V10 — small-cap momentum, encoded from PARAMETERS.md
// =============================================================================
// Strategy version 10. (Pine's own language version is 6 — different number,
// different thing.)
//
// Section numbers below refer to knowledge-base/strategies/PARAMETERS.md.
//
// V10 carries six corrections found by running the Python replay engine
// (src/paper_trading/replay.py) against session data. Each is marked [FIX-n]
// at the point it applies:
//
//   [FIX-1] The pullback counter must reset on a new high of day, on a VWAP
//           break, and on a close under the prior dip low. Without those it
//           climbs all session, the gate never opens, and the strategy reports
//           zero trades — which is indistinguishable from "selective".
//   [FIX-2] The §4 trigger candle IS the candle that ends the pullback, so the
//           dip's low and volume must be captured before it. Here the entry is
//           a resting stop order placed during the dip, which sidesteps the
//           problem entirely and cannot repaint.
//   [FIX-3] Size must be capped by cash. §7's risk formula alone asks a $100k
//           account for ~20,000 shares of a $5 stock.
//   [FIX-4] Size must also be capped by participation in the tape. On a
//           sub-20M float that fill does not exist at any price. §7 concedes
//           this: "fill quality degrades with size on sub-20M float."
//   [FIX-5] The §3 support tolerance needs a floor of one tick. 0.25% of a
//           $2.00 stock is half a tick, so no level can match except by exact
//           equality — the gate is unreachable across the bottom of §1's range.
//   [FIX-6] §8's daily limits are not optional garnish. Without them a losing
//           day compounds instead of stopping.
//
// Costs are declared in the strategy() call, not bolted on: $0.005/share
// commission and 2 ticks of slippage each way. At §5's $0.08 stop that round
// trip is 0.62R, which moves §9's breakeven win rate from 33.3% to ~45%.
// =============================================================================

strategy("Ross Momentum V10", overlay = true,
     initial_capital        = 100000,
     default_qty_type       = strategy.fixed,
     default_qty_value      = 0,
     commission_type        = strategy.commission.cash_per_contract,
     commission_value       = 0.005,
     slippage               = 2,
     calc_on_every_tick     = false,
     process_orders_on_close = false,
     pyramiding             = 0)

// ----------------------------------------------------------------- inputs
grpU = "§1 universe"
priceMin      = input.float(2.00,  "Min price",              group = grpU)
priceMax      = input.float(20.00, "Max price",              group = grpU)

grpS = "§2 session (exchange time)"
entryWindow   = input.session("0935-1130", "Entry window",   group = grpS)
primeWindow   = input.session("0930-1030", "Prime window",   group = grpS)
flatAtEnd     = input.bool(true, "Flatten at window close",  group = grpS)

grpE = "§3/§4 entry"
tolPct        = input.float(0.25, "Support tolerance %", step = 0.05, group = grpE,
     tooltip = "§3 leaves this unstated. Sweep 0.10-0.50; do not tune it.")
confluenceMin = input.int(2, "Min confluence reasons", minval = 1, group = grpE)
maxPbIndex    = input.int(2, "Max pullback index",     minval = 1, group = grpE)

grpX = "§5/§6 risk"
stopMaxDist   = input.float(0.20, "Max stop distance $",     group = grpX)
minRR         = input.float(2.0,  "Min reward:risk",         group = grpX)
scale1Pct     = input.int(50, "Scale % at target 1",         group = grpX)

grpZ = "§7/§8 sizing and limits"
riskPct       = input.float(2.0,  "Risk % of equity",        group = grpZ)
participPct   = input.float(10.0, "Max % of minute volume",  group = grpZ,
     tooltip = "[FIX-4] You cannot be most of the tape without becoming the price.")
maxTradesDay  = input.int(2,   "Max trades per day",         group = grpZ)
maxDayLossPct = input.float(6.0,  "Max daily loss %",        group = grpZ)
givebackPct   = input.float(50.0, "Giveback % of peak gain", group = grpZ)
consecLossMax = input.int(3,   "Consecutive losses",         group = grpZ)
ddWalkawayPct = input.float(20.0, "Drawdown walkaway %",     group = grpZ)

// ------------------------------------------------------------- indicators
ema9    = ta.ema(close, 9)
ema20   = ta.ema(close, 20)
ma200   = ta.sma(close, 200)
vwapV   = ta.vwap(hlc3)
[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)

inEntryWindow = not na(time(timeframe.period, entryWindow))
inPrime       = not na(time(timeframe.period, primeWindow))
newDay        = ta.change(time("D")) != 0

// ------------------------------------------------------- §1 price filter
priceOk = close >= priceMin and close <= priceMax
// NOTE: float <= 20M and the news catalyst (§1) are NOT computable on a chart.
// They are the trader's manual pre-check. This script assumes the symbol
// already passed them; it cannot verify that, and silently treating them as
// satisfied is how a backtest flatters itself.

// -------------------------------------------------- [FIX-1] pullback state
var float hod           = na      // high of day, premarket included
var int   pbIndex       = 0       // pullbacks in the CURRENT leg
var bool  inPB          = false
var float legLow        = -1e10   // low of the last completed dip
var float dipRunLow     = na      // running low of the dip in progress
var float dipVolSum     = 0.0
var int   dipBars       = 0
var float impVolSum     = 0.0
var int   impBars       = 0
// the dip that is currently tradable (captured before any trigger) [FIX-2]
var float dipLow        = na
var float dipVolAvg     = na
var float impVolAvg     = na
var int   dipIndex      = 0
var bool  dipArmed      = false

if newDay
    hod       := high
    pbIndex   := 0
    inPB      := false
    legLow    := -1e10
    dipArmed  := false
    impVolSum := 0.0
    impBars   := 0

// The move is over: losing VWAP is a §5 hard invalidation, and a close under
// the prior dip low breaks the leg. Either way the dip count starts again.
brokeStructure = close < vwapV or close < legLow

if brokeStructure
    pbIndex   := 0
    inPB      := false
    legLow    := -1e10
    dipArmed  := false
    impVolSum := volume
    impBars   := 1
    hod       := math.max(nz(hod, high), high)
else
    isNewHod = high > nz(hod, high)
    if high > high[1]
        if inPB
            // The dip resolved on this bar. Freeze it so the just-completed
            // pullback stays inspectable after the trigger erases the live
            // state. [FIX-2]
            dipLow    := dipRunLow
            dipVolAvg := dipBars > 0 ? dipVolSum / dipBars : na
            dipIndex  := pbIndex
            dipArmed  := true
            legLow    := dipRunLow
            inPB      := false
            impVolSum := volume
            impBars   := 1
        else
            impVolSum := impVolSum + volume
            impBars   := impBars + 1
    else
        if not inPB
            // A dip begins. Freeze the impulse it is pulling back from NOW —
            // the §3 volume test compares against the push, and the push is
            // over. [FIX-2]
            impVolAvg := impBars > 0 ? impVolSum / impBars : na
            inPB      := true
            dipArmed  := false
            pbIndex   := pbIndex + 1
            dipRunLow := low
            dipVolSum := volume
            dipBars   := 1
        else
            dipRunLow := math.min(dipRunLow, low)
            dipVolSum := dipVolSum + volume
            dipBars   := dipBars + 1
    if isNewHod
        // A new high of day starts a new leg; earlier dips stop counting
        // against it. Without this the index only ever climbs. [FIX-1]
        pbIndex := 0
        hod     := high

// --------------------------------------------- §3 at_support (confluence)
// [FIX-5] floor the tolerance at one tick, or a $2 stock gets a half-cent
// window and nothing can ever match.
tolOf(float p) =>
    math.max(math.abs(p) * tolPct / 100.0, syminfo.mintick)

// A confirmed pivot high, used as a "flipped level" (was resistance, now
// support). ta.pivothigh(2,2) is only known 2 bars later, and referencing it
// with that offset is what keeps this from repainting.
pivotHi = ta.pivothigh(high, 2, 2)
var float lastFlip = na
if not na(pivotHi)
    lastFlip := pivotHi

confluenceAt(float p) =>
    float tol = tolOf(p)
    int n = 0
    n += math.abs(p - math.round(p * 2) / 2) <= tol ? 1 : 0   // whole/half dollar
    n += math.abs(p - ema9)  <= tol ? 1 : 0
    n += math.abs(p - ema20) <= tol ? 1 : 0
    n += not na(ma200) and math.abs(p - ma200) <= tol ? 1 : 0
    n += math.abs(p - vwapV) <= tol ? 1 : 0
    n += not na(lastFlip) and math.abs(p - lastFlip) <= tol and p >= lastFlip - tol ? 1 : 0
    n

// ------------------------------------------------------- [FIX-6] §8 gate
var float dayStartEq  = na
var float dayPeakEq   = na
var float hwm         = na
var int   dayTrades   = 0
var int   consecLoss  = 0
var bool  locked      = false
var string lockReason = ""

if newDay
    dayStartEq := strategy.equity
    dayPeakEq  := strategy.equity
    dayTrades  := 0
    consecLoss := 0
    locked     := false
    lockReason := ""

dayStartEq := nz(dayStartEq, strategy.equity)
dayPeakEq  := math.max(nz(dayPeakEq, strategy.equity), strategy.equity)
hwm        := math.max(nz(hwm, strategy.equity), strategy.equity)

// Re-evaluate §8 whenever a trade closes.
if ta.change(strategy.closedtrades) > 0
    lastProfit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    dayTrades  := dayTrades + 1
    consecLoss := lastProfit > 0 ? 0 : consecLoss + 1

    lossPct    = (dayStartEq - strategy.equity) / dayStartEq * 100.0
    peakGain   = dayPeakEq - dayStartEq
    givenBack  = peakGain > 0 ? (dayPeakEq - strategy.equity) / peakGain * 100.0 : 0.0
    ddPct      = (hwm - strategy.equity) / hwm * 100.0

    if lossPct >= maxDayLossPct
        locked := true
        lockReason := "max daily loss"
    else if peakGain > 0 and givenBack >= givebackPct
        locked := true
        lockReason := "giveback of peak gain"
    else if dayPeakEq > dayStartEq and strategy.equity < dayStartEq
        locked := true
        lockReason := "green to red"
    else if consecLoss >= consecLossMax
        locked := true
        lockReason := "consecutive losses"
    else if ddPct >= ddWalkawayPct
        locked := true
        lockReason := "drawdown walkaway"

canTrade = not locked and dayTrades < maxTradesDay and inEntryWindow and priceOk

// ------------------------------------------------------------ §3 gate
// Evaluated while the dip is armed and BEFORE the break — this is the
// playbook's Step 3 (confirm the chart) preceding Step 4 (wait for the
// trigger), and it is why the entry can rest as a stop order.
// The live dip is what a trader is looking at while the order rests; the
// frozen copy is what remains once the trigger bar has closed. Using the live
// values here is what lets the entry be a resting stop order rather than a
// decision made after the break has already happened.
liveDipLow = inPB ? dipRunLow : dipLow
liveDipVol = inPB ? (dipBars > 0 ? dipVolSum / dipBars : na) : dipVolAvg
liveIndex  = inPB ? pbIndex : dipIndex
liveInDip  = inPB or dipArmed

stopPrice    = liveDipLow
entryPrice   = high + syminfo.mintick        // the break of THIS bar's high
riskPerShare = entryPrice - stopPrice

targetHod    = nz(hod, high)
target1      = targetHod > entryPrice ? targetHod : entryPrice + 2 * riskPerShare
rewardRisk   = riskPerShare > 0 ? (target1 - entryPrice) / riskPerShare : 0.0

gateMacd   = macdHist > 0
gateVwap   = close > vwapV
gateEma9   = close > ema9
gateVol    = not na(liveDipVol) and not na(impVolAvg) and liveDipVol < impVolAvg
gateIndex  = liveIndex >= 1 and liveIndex <= maxPbIndex
gateSupport = not na(stopPrice) and confluenceAt(stopPrice) >= confluenceMin
gateStop   = riskPerShare > 0 and riskPerShare <= stopMaxDist       // §5
gateRR     = rewardRisk >= minRR                                     // §6

// NOTE: §3 also requires tape_green and no_seller_wall. Both need Level 2,
// which Pine does not have. They are NOT evaluated here and NOT assumed true —
// every signal below is conditional on the trader confirming them by eye.
setupValid = liveInDip and gateMacd and gateVwap and gateEma9 and gateVol and
             gateIndex and gateSupport and gateStop and gateRR

// ------------------------------------------------------- §7 position size
// Three caps, not one: risk budget, cash, and participation. [FIX-3][FIX-4]
tapeMedian = ta.median(volume, 20)
qtyByRisk  = riskPerShare > 0 ? math.floor(strategy.equity * riskPct / 100.0 / riskPerShare) : 0
qtyByCash  = entryPrice   > 0 ? math.floor(strategy.equity / entryPrice) : 0
qtyByTape  = tapeMedian   > 0 ? math.floor(tapeMedian * participPct / 100.0) : 0
qty        = math.max(0, math.min(math.min(qtyByRisk, qtyByCash), qtyByTape))

// ------------------------------------------------------------- execution
// §4: "the first candle to trade above the high of the previous candle."
// A resting stop order fills exactly on that event and cannot look ahead.
if canTrade and setupValid and qty > 0 and strategy.position_size == 0
    strategy.entry("L", strategy.long, qty = qty, stop = entryPrice,
         comment = "pb" + str.tostring(liveIndex))

// Cancel the resting order the moment the setup stops being valid.
if strategy.position_size == 0 and (not setupValid or not canTrade)
    strategy.cancel("L")

// --------------------------------------------------------------- §6 exits
var float posStop   = na
var float posTarget = na
var bool  scaled    = false

if strategy.position_size > 0 and strategy.position_size[1] == 0
    posStop   := stopPrice
    posTarget := target1
    scaled    := false

inPos = strategy.position_size > 0

// §6 hard exits — any one invalidates the thesis.
exitNewLow  = inPos and low < low[1]
exitMacd    = inPos and macdHist < 0
exitVwap    = inPos and close < vwapV
avgVol      = ta.sma(volume, 20)
exitHeavy   = inPos and close < open and volume > 2 * avgVol
hardExit    = exitNewLow or exitMacd or exitVwap or exitHeavy

// Scale §6 scale_1_pct at target 1, then move the stop to breakeven (§5).
if inPos and not scaled and high >= posTarget
    strategy.close("L", qty_percent = scale1Pct, comment = "scale target1")
    scaled  := true
    posStop := strategy.position_avg_price          // §5 breakeven_trigger

if inPos
    strategy.exit("stop", from_entry = "L", stop = posStop)

if hardExit
    reason = exitNewLow ? "new low" : exitMacd ? "macd<0" : exitVwap ? "vwap break" : "heavy red"
    strategy.close("L", comment = reason)

// §2: nothing is held past the hard stop.
if flatAtEnd and not inEntryWindow and inPos
    strategy.close("L", comment = "session end")

// ----------------------------------------------------------------- plots
plot(ema9,  "EMA9",  color.new(color.orange, 0), linewidth = 1)
plot(ema20, "EMA20", color.new(color.blue, 0),   linewidth = 1)
plot(vwapV, "VWAP",  color.new(color.purple, 0), linewidth = 2)
plot(ma200, "MA200", color.new(color.gray, 0),   linewidth = 1)
plot(hod,   "HOD",   color.new(color.teal, 60),  style = plot.style_stepline)

bgcolor(locked ? color.new(color.red, 92) : inPrime ? color.new(color.green, 95) : na,
     title = "risk lock / prime window")

plotshape(setupValid and canTrade and strategy.position_size == 0,
     title = "armed", style = shape.triangleup, location = location.belowbar,
     color = color.new(color.green, 0), size = size.tiny)

// --------------------------------------------------------------- table
var table hud = table.new(position.top_right, 2, 8, border_width = 1)
if barstate.islast
    table.cell(hud, 0, 0, "V10 state",  bgcolor = color.new(color.gray, 70))
    table.cell(hud, 1, 0, locked ? "LOCKED: " + lockReason : "active",
         bgcolor = locked ? color.new(color.red, 60) : color.new(color.green, 70))
    table.cell(hud, 0, 1, "pullback #"), table.cell(hud, 1, 1, str.tostring(liveIndex))
    table.cell(hud, 0, 2, "confluence")
    table.cell(hud, 1, 2, na(stopPrice) ? "-" : str.tostring(confluenceAt(stopPrice)))
    table.cell(hud, 0, 3, "risk/share")
    table.cell(hud, 1, 3, str.tostring(riskPerShare, format.mintick))
    table.cell(hud, 0, 4, "reward:risk")
    table.cell(hud, 1, 4, str.tostring(rewardRisk, "#.##"))
    table.cell(hud, 0, 5, "qty (r/c/t)")
    table.cell(hud, 1, 5, str.tostring(qtyByRisk) + "/" + str.tostring(qtyByCash) +
         "/" + str.tostring(qtyByTape))
    table.cell(hud, 0, 6, "trades today"), table.cell(hud, 1, 6, str.tostring(dayTrades))
    table.cell(hud, 0, 7, "consec losses"), table.cell(hud, 1, 7, str.tostring(consecLoss))
