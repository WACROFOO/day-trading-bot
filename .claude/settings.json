{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/index_first_hook.sh\"",
            "timeout": 20,
            "statusMessage": "Checking the index-first rule..."
          },
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/factcheck_hook.sh\"",
            "timeout": 60,
            "statusMessage": "Fact-checking citations against the knowledge base..."
          }
        ]
      }
    ]
  }
}
