# Copy this file to `.env` and paste your own keys. `.env` is git-ignored:
# it must never be committed, shared, or pasted into a chat.
#
# Alpaca -> https://app.alpaca.markets -> Home -> API Keys -> Generate
# Use the PAPER keys while you are learning.
ALPACA_KEY_ID=your_key_id_here
ALPACA_SECRET_KEY=your_secret_key_here

# iex  = free real-time single venue (default). Carries little PREMARKET volume
#        in microcaps: before ~07:00 ET a runner may show no IEX bars at all
#        while other venues print. The desk says so and shows IEX's last print.
# sip  = full consolidated tape, paid subscription (Alpaca "Algo Trader Plus").
#        This is the fix for premarket coverage. Nothing free provides it.
ALPACA_FEED=iex

# Paper trading endpoint. Change only when you knowingly go live.
ALPACA_TRADING_BASE=https://paper-api.alpaca.markets

# SEC EDGAR is free and needs no account, but its policy requires a
# User-Agent naming a real contact. Requests without one get HTTP 403.
SEC_USER_AGENT=Your Name your@email.com

# Price band. The Confirmed course pillar is $2-20. Set this to widen the low
# end for your own universe (e.g. 1). The desk then labels the band as YOURS
# wherever it appears, never as Ross's.
DESK_PRICE_MIN=2

# Premarket quotes for the screener card. "yahoo" (default) uses Yahoo Finance's
# public quote endpoint: consolidated, ~15 minutes delayed, unofficial — the one
# free number that reflects a premarket move IEX has not printed. "off" keeps
# the screener on IEX only. Display and discovery only: the pillars and the
# scanners stay on the entitled feed.
PREMARKET_QUOTES=yahoo
