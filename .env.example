# Copy this file to `.env` and paste your own keys. `.env` is git-ignored:
# it must never be committed, shared, or pasted into a chat.
#
# Alpaca -> https://app.alpaca.markets -> Home -> API Keys -> Generate
# Use the PAPER keys while you are learning.
ALPACA_KEY_ID=your_key_id_here
ALPACA_SECRET_KEY=your_secret_key_here

# iex  = free real-time single venue (default)
# sip  = full consolidated tape, paid subscription
ALPACA_FEED=iex

# Paper trading endpoint. Change only when you knowingly go live.
ALPACA_TRADING_BASE=https://paper-api.alpaca.markets
