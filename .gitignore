# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Data & results
data/cache/
*.csv
*.parquet
results/

# ...but these CSVs ARE the deliverable, not scratch. The blanket *.csv
# above silently dropped them from `git add <dir>`: the commit succeeded,
# the file 404'd on GitHub. Keep any new data table listed here.
!research/challenge-tickers/*.csv
!research/megaday-study/data/*.csv
!research/trade-journal/*.csv
!research/trade-log/*.csv
# The first-pullback edge study: its tables ARE the deliverable (brief sect.
# 30 asks for them by name). The 121MB bar cache under data/cache/ is NOT —
# it is regenerable from the provider and is excluded below.
!research/first-pullback-edge/data/*.csv
!research/first-pullback-edge/data/halts.csv
!research/first-pullback-edge/data/*.parquet
# The setup ledger is 189k rows x ~50 columns. Parquet is 13MB and is the
# format the brief asks for; the CSV mirror is 115MB, over GitHub's 100MB
# per-file limit. Parquet only for this one table.
research/first-pullback-edge/data/rejected_setups.csv
!research/first-pullback-edge/results/
!research/first-pullback-edge/results/*.csv
# Live progress logs of long background runs. These churn on every write and
# would otherwise make the tree dirty every turn; the FINAL log is copied to
# the tracked name and committed when the run lands.
research/first-pullback-edge/results/*.live.log
research/first-pullback-edge/data/cache/
research/first-pullback-edge/data/symbol_pool.json

# Secrets
.env
.env.*
*.env
*.key
research/first-pullback-edge/.env.local
config.local.py

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Raw scrape working directory. The cleaned transcripts under
# knowledge-base/transcripts/ are published; these staging copies are not.
data/subtitles/
data/subtitles_raw/

# Fetch logs
data/*.log

# Runtime artifacts
data/*.db

# scratch / hook side-effects
research/index-failures.log
